{
  "manifest_version": 3,
  "name": "Kitty Download Manager",
  "version": "8.57",
  "description": "Gestionnaire de téléchargements multimédia persistant basé sur yt-dlp.",
  "permissions": [
    "activeTab",
    "menus",
    "nativeMessaging",
    "storage",
    "clipboardWrite",
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse"
  ],
  "action": {
    "default_title": "Kitty Download Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kitty-download-manager@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteActivity"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": [
      "shared.js",
      "media-resolver.js",
      "hls-parser.js",
      "request-context.js",
      "hls-detector.js",
      "hls-response.js",
      "media-items.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "i18n.js",
        "shared.js",
        "media-resolver.js",
        "content-pill.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared.js",
        "media-resolver.js",
        "media-dom.js",
        "media-context.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
